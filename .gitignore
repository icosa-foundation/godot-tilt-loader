# Godot 4+ .gitignore for C# projects

# Godot-specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Mono/C# specific ignores (BUILD OUTPUTS ONLY)
[Bb]in/
[Oo]bj/
[Ll]ogs/
*.pdb
*.mdb
*.user
*.suo
*.tmp
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# DO NOT ignore .csproj and .sln for Godot!
# These files contain important project configuration and must be committed
# (Unlike Unity, Godot doesn't auto-generate these)

# IDE specific
.vs/
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~

# Claude Code
.claude/

# Build outputs
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab
*.app

# OS specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
