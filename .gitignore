# Godot 4+ GDScript project ignores

# Godot-specific ignores
.godot/
.import/
export.cfg
export_presets.cfg
!Tests/NativeHullRuntimeProject/export_presets.cfg
__pycache__/
*.py[cod]

# Build/cache outputs
[Bb]in/
[Oo]bj/
[Ll]ogs/
*.obj
*.obj.import
*.csv.import
*.tilt.import
*.translation
*.pdb
*.mdb
*.user
*.suo
*.tmp
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# IDE specific
.vs/
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~

# Claude Code
.claude/

# Manifest-managed addon caches and local dependency payloads
.plugged/
.addons/
.deps/
addons/icosa/

# Build outputs
/[Bb]uild/
/[Bb]uilds/
/[Tt]emp/
native/open_brush_hull/build/
native/open_brush_hull/.sconsign
native/open_brush_hull/.sconsign.dblite
native/open_brush_hull/src/.sconsign
native/open_brush_hull/extension_api.json
Tests/NativeHullRuntimeProject/native/
Tests/NativeHullRuntimeProject/exports/
*.apk
*.aab
*.app

# Commit distributable open_brush_hull binaries while keeping compiler outputs local.
!native/open_brush_hull/bin/
native/open_brush_hull/bin/*
!native/open_brush_hull/bin/.gdignore
!native/open_brush_hull/bin/windows/
native/open_brush_hull/bin/windows/*
!native/open_brush_hull/bin/windows/*.dll
!native/open_brush_hull/bin/linux/
native/open_brush_hull/bin/linux/*
!native/open_brush_hull/bin/linux/*.so
!native/open_brush_hull/bin/macos/
native/open_brush_hull/bin/macos/*
!native/open_brush_hull/bin/macos/*.dylib
!native/open_brush_hull/bin/android/
native/open_brush_hull/bin/android/*
!native/open_brush_hull/bin/android/*.so
!native/open_brush_hull/bin/ios/
native/open_brush_hull/bin/ios/*
!native/open_brush_hull/bin/ios/*.dylib
!native/open_brush_hull/bin/web/
native/open_brush_hull/bin/web/*
!native/open_brush_hull/bin/web/*.wasm

# OS specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
